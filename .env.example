# Public site URL used for canonical links and contact-form origin checks.
NEXT_PUBLIC_SITE_URL=https://www.supertechengg.in

# SMTP settings used by the contact form.
# Gmail example: smtp.gmail.com, port 465, secure true, App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supertech074@gmail.com
SMTP_PASS=replace-with-your-16-character-google-app-password

# MAIL_FROM must be the authenticated mailbox (optionally with a display name).
MAIL_FROM="SuperTech Website <supertech074@gmail.com>"

# Where enquiries are delivered. Multiple addresses can be comma-separated.
MAIL_TO=supertech074@gmail.com

# /etc/nginx/sites-available/supertech
#
# Start with this HTTP block, then run Certbot to add TLS:
#   sudo certbot --nginx -d supertechengg.in -d www.supertechengg.in
#
# The app listens on 127.0.0.1:3000 (see ecosystem.config.cjs).

server {
    listen 80;
    listen [::]:80;
    server_name supertechengg.in www.supertechengg.in;

    client_max_body_size 1m;
    server_tokens off;

    gzip on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite rather than append: the app trusts this value for rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}

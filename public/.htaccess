# Hostinger / Apache configuration for the static Next.js export.
# This file is copied into `out/` by `next build` and uploaded with the site.

Options -Indexes
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS (Hostinger provides a free SSL certificate).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonical host: redirect the bare domain to www.
  #    Change or remove this block if the canonical domain is non-www.
  RewriteCond %{HTTP_HOST} ^supertechengg\.in$ [NC]
  RewriteRule ^ https://www.supertechengg.in%{REQUEST_URI} [L,R=301]

  # 3. Add the trailing slash Next.js uses for exported routes.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Static export 404 page.
ErrorDocument 404 /404.html

# Do not serve source or environment files if they are ever uploaded by mistake.
<FilesMatch "(^\.env|^\.git|^package(-lock)?\.json$|^tsconfig\.json$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Security headers.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets never change, so cache them for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must be revalidated so new deployments appear immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
